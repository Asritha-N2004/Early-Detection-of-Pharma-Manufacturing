# Set both secrets before Docker startup. Never commit .env.
BOOTSTRAP_PASSWORD=
JWT_SECRET=
POSTGRES_PASSWORD=
DEPLOYMENT_MODE=demo
EMBEDDED_WORKER=1
# Optional separate checkpoint store. Defaults to a sibling SQLite file locally,
# or the same PostgreSQL database with separate checkpoint tables in Docker.
# CHECKPOINT_DATABASE_URL=sqlite:///./pharma-workflows.db
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Local default is sqlite:///./pharma.db. Docker uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://pharma:YOUR_PASSWORD@localhost:5432/pharma
